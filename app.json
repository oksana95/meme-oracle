{
  "expo": {
    "name": "Спроси пса",
    "slug": "meme-oracle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memeoracle",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09051C",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.oksanadergunova.askthedog",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oksanadergunova.askthedog",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#09051C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/launch-mascot.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#09051C",
          "android": {
            "image": "./assets/images/launch-mascot.png",
            "imageWidth": 190,
            "resizeMode": "contain",
            "backgroundColor": "#09051C"
          }
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "638ed5b0-70b9-44d2-a94f-007730b89d5b"
      }
    },
    "owner": "oksanadergunova"
  }
}
